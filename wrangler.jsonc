// Cloudflare Workers – nur für Vorschau-Links (habitora.mischaweyermann.workers.dev).
// Die echte Seite habitora.ch läuft weiterhin über .github/workflows/deploy.yml auf Metanet.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "habitora",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  // eigene Vorschau-Adresse pro Version/Branch
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    // /v2 → /v2/, /impressum → /impressum/ (wie .htaccess auf Metanet)
    "html_handling": "auto-trailing-slash",
    // unbekannte Adressen zeigen site/404.html
    "not_found_handling": "404-page"
  }
}
